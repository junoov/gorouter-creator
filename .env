# ============================================================
#  GoRouter Creator — semua setting di sini.
#  Jalankan cukup: python3 main.py
# ============================================================

# --- Jumlah akun per run ---
COUNT=1

# --- Menu setting di awal ---
# 1 = tampilkan menu setting dulu (bisa ubah jumlah akun, referral, headless, dll)
# 0 = langsung jalan pakai setting di file ini tanpa ditanya
INTERACTIVE=1

# --- Browser ---
# 1 = headless (tanpa jendela), 0 = browser muncul
HEADLESS=0

# --- Noov temp email (wajib) ---
# Login ke https://mail.noov.app, copy cookie mailflare_session
NOOV_COOKIE=NktPD9TPDhP4sGg38RsTBA-3AJ76lMh-16apfgDOlB4
NOOV_API_BASE=https://mail.noov.app

# --- GoRouter ---
GR_BASE_URL=https://gorouter.app
# Kode referral saja, bukan URL penuh. Bisa juga pakai: python3 main.py --aff KODE
GR_AFF_CODE=aP1o

# --- 9Router ---
# 1 = otomatis import API key ke 9Router setelah dibuat
ADD_TO_ROUTER=1
ROUTER_URL=http://127.0.0.1:20128
# Kosongkan kalau "Require Login" sudah dimatikan di 9Router
ROUTER_PASS=
# Provider node di 9Router (dipakai kalau ada, dibuat kalau belum)
ROUTER_NODE_NAME=gorouter
ROUTER_NODE_PREFIX=go
ROUTER_NODE_BASE_URL=https://gorouter.app/v1
ROUTER_DEFAULT_MODEL=gpt

# --- Proxy ---
# 1 = pakai proxy pool dari proxies.txt (dirotasi tiap akun)
USE_PROXY_POOL=1
PROXY_FILE=proxies.txt
# Jeda minimal (detik) sebelum satu proxy dipakai lagi
PROXY_COOLDOWN=600

# --- Anti rate-limit / DataDome ---
# Jeda antar akun (detik). Naikkan ke 180-300 kalau sering kena
# "Access is temporarily restricted".
DELAY_BETWEEN_ACCOUNTS=90
# Retry saat kena DataDome (backoff: 12s, 25s, 50s, 100s, 180s)
DATADOME_RETRIES=6
